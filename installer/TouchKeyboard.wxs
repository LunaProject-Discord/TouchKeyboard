<?xml version="1.0" encoding="utf-8"?>
<!--
  TouchKeyboard の MSI パッケージ定義。

  uiAccess="true" のアプリは次の両方を満たさないと起動できない。
    - 実行ファイルが Authenticode 署名済みであること
    - Program Files 配下など、信頼された場所から起動されること

  そのため、このパッケージは配置・ショートカット作成に加えて、
  署名用の自己署名証明書をこの PC の「信頼されたルート証明機関」と
  「信頼された発行元」へ登録するところまで面倒を見る。

  実行ファイルへの署名自体はビルド時（build-msi.ps1）に済ませてある。
  MSI はファイルをそのままコピーするだけなので、署名は保持される。

  ファイル一覧（730 個の自己完結配置一式）は手書きせず、
  generate-files.ps1 が publish 出力から Files.wxs を生成する。
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="TouchKeyboard"
           Manufacturer="Luna Project"
           Version="1.0.0.0"
           UpgradeCode="9752077B-24FC-4F9C-86B4-6F591EA65D85"
           Scope="perMachine"
           Codepage="65001">

    <MajorUpgrade DowngradeErrorMessage="より新しいバージョンの TouchKeyboard がすでにインストールされています。" />
    <MediaTemplate EmbedCab="yes" />

    <!-- 上書き配置の前に、動作中のアプリへ終了を促す。 -->
    <util:CloseApplication Target="TouchKeyboard.exe" CloseMessage="yes" ElevatedCloseMessage="yes" RebootPrompt="no" />

    <Icon Id="AppIcon.ico" SourceFile="..\src\TouchKeyboard\Assets\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="TouchKeyboard">
        <Component Id="MainExecutable" Guid="*">
          <File Id="TouchKeyboardExe" Name="TouchKeyboard.exe" Source="publish\TouchKeyboard.exe" KeyPath="yes" />
        </Component>

        <!-- 署名検証用の公開鍵のみ。秘密鍵は含まない。 -->
        <Component Id="TrustCertFile" Guid="*">
          <File Id="CertFile" Name="LunaProject.cer" Source="LunaProject.cer" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ApplicationShortcut" Guid="*">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="TouchKeyboard"
                  Description="ATOK の入力ミス補正に対応したタッチキーボード"
                  Target="[#TouchKeyboardExe]"
                  WorkingDirectory="INSTALLFOLDER" />
        <!--
          HKCU で問題ない。ALLUSERS=1（per-machine）のインストールでは
          Windows Installer が HKCU への書き込みを HKEY_USERS\.DEFAULT へ
          振り替えるため、全ユーザー向けの値として機能する。
        -->
        <RegistryValue Root="HKCU" Key="Software\TouchKeyboard" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="TouchKeyboard" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="TrustCertFile" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentGroupRef Id="PublishComponents" />
    </Feature>

    <!--
      証明書の信頼登録。インストールのときだけ行い、アンインストールでは
      何もしない（開発ビルドと共有している証明書のため、外さずそのまま残す）。

      certutil -addstore は既に登録済みでも安全に再実行できる。
    -->
    <CustomAction Id="TrustCertRoot"
                  Directory="INSTALLFOLDER"
                  ExeCommand='"[SystemFolder]certutil.exe" -f -addstore Root "[#CertFile]"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="TrustCertPublisher"
                  Directory="INSTALLFOLDER"
                  ExeCommand='"[SystemFolder]certutil.exe" -f -addstore TrustedPublisher "[#CertFile]"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="TrustCertRoot" After="InstallFiles" Condition='NOT REMOVE~="ALL"' />
      <Custom Action="TrustCertPublisher" After="TrustCertRoot" Condition='NOT REMOVE~="ALL"' />
    </InstallExecuteSequence>

  </Package>
</Wix>
