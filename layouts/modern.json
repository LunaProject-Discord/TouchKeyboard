        { "label": "¥", "shiftLabel": "|", "scanCode": "0x7D", "fnHidden": true },
        // Fn を押している間は Delete になる。クラシックのファンクション段で
        // Delete が置かれていた場所は、この配列では BS が占めている。
        { "label": "BS", "icon": "E750", "iconOnly": true, "scanCode": "0x0E", "width": 1.25, "tone": "modifier",
          "fnLabel": "Delete", "fnScanCode": "0x53", "fnExtended": true }
      ]
    },
    {
      "keys": [
        // アイコンの字形が行の中で上に寄っているぶんを下げる。クラシックと同じ実測値。
        { "label": "Tab", "icon": "E7FD", "scanCode": "0x0F", "width": 1.75, "tone": "modifier", "faceOffset": 0.05, "pairedFaceOffset": 0.125 },
        { "label": "q", "shiftLabel": "Q", "scanCode": "0x10" },
        { "label": "w", "shiftLabel": "W", "scanCode": "0x11" },
        { "label": "e", "shiftLabel": "E", "scanCode": "0x12" },
        { "label": "r", "shiftLabel": "R", "scanCode": "0x13" },
        { "label": "t", "shiftLabel": "T", "scanCode": "0x14" },
        { "label": "y", "shiftLabel": "Y", "scanCode": "0x15" },
        { "label": "u", "shiftLabel": "U", "scanCode": "0x16" },
