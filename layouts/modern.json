{
  // モダン。クラシックからファンクション段を落とした派生。
  //
  // 段が 1 つ減るぶん、同じ高さでもキーが大きくなる。
  // 落とした Esc と F1〜F12 は次のように置き換える。
  //   Esc      … 半角/全角 の位置へ
  //   F1〜F12  … Fn を押している間だけ数字段に出す
  //
  // 変換まわりは IME の入／切（A / あ）に置き換え、かなは置かない。
  "name": "モダン",
  "rowUnits": 15.5,
  "rows": [
