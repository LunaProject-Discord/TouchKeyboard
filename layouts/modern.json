      "keys": [
        { "label": "Esc", "scanCode": "0x01", "width": 1.25, "repeatable": false, "tone": "modifier" },
        { "label": "1", "shiftLabel": "!", "scanCode": "0x02", "fnLabel": "F1", "fnScanCode": "0x3B" },
        { "label": "2", "shiftLabel": "\"", "scanCode": "0x03", "fnLabel": "F2", "fnScanCode": "0x3C" },
        { "label": "3", "shiftLabel": "#", "scanCode": "0x04", "fnLabel": "F3", "fnScanCode": "0x3D" },
        { "label": "4", "shiftLabel": "$", "scanCode": "0x05", "fnLabel": "F4", "fnScanCode": "0x3E" },
        { "label": "5", "shiftLabel": "%", "scanCode": "0x06", "fnLabel": "F5", "fnScanCode": "0x3F" },
        { "label": "6", "shiftLabel": "&", "scanCode": "0x07", "fnLabel": "F6", "fnScanCode": "0x40" },
        { "label": "7", "shiftLabel": "'", "scanCode": "0x08", "fnLabel": "F7", "fnScanCode": "0x41" },
        { "label": "8", "shiftLabel": "(", "scanCode": "0x09", "fnLabel": "F8", "fnScanCode": "0x42" },
        { "label": "9", "shiftLabel": ")", "scanCode": "0x0A", "fnLabel": "F9", "fnScanCode": "0x43" },
        { "label": "0", "scanCode": "0x0B", "fnLabel": "F10", "fnScanCode": "0x44" },
        { "label": "-", "shiftLabel": "=", "scanCode": "0x0C", "fnLabel": "F11", "fnScanCode": "0x57" },
        { "label": "^", "shiftLabel": "~", "scanCode": "0x0D", "fnLabel": "F12", "fnScanCode": "0x58" },
        // Fn 中は畳む。空いた 1 ユニットを F1〜F12 の 12 個が等分し、
