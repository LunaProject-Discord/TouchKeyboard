    {
      "height": 0.5,
      "rowSpan": 2,
      "keys": [
        { "label": "Ctrl", "scanCode": "0x1D", "modifier": "Ctrl" },
        { "label": "Fn", "scanCode": "0x00", "modifier": "Fn" },
        { "label": "Win", "isWindowsLogo": true, "iconOnly": true, "scanCode": "0x5B", "extended": true, "modifier": "Win" },
        { "label": "Alt", "scanCode": "0x38", "modifier": "Alt" },

        // IME の入／切。刻印は Microsoft が 2019 年に定めた ImeOn / ImeOff の
        // キーボードに合わせ、スペースの左が「A」、右が「あ」とする。
        // Surface などに載っている配列で、無変換・変換・カタカナひらがなの 3 つが
        // この 2 つに置き換わっている。
        //
        // 送るのは仮想キー。この 2 つはスキャンコードでは送れない。
        //
        // 実機のスキャンコードは E0 F1 / E0 F2 だが、ビット 7 は解放を表す位置にあり、
        // 注入すると落とされて 0x71 / 0x72 になる。実測したところ仮想キー 0xFF
        // （無効）として届き、IME には何も伝わらなかった。
        // 仮想キーで送れば 0x1A / 0x16 として正しく届く。
        //
        // scanCode は配列から引けなかった場合の代わり。無変換・変換を送る。
        // これで IME が切り替わるかは環境による。開発機では PowerToys が
        // 無変換・変換を IME の入／切へ割り当てており、そちら経由で通っている。
        // 素の Windows では単に無変換・変換が押されただけになる。
        { "label": "A", "boxedLabel": true, "virtualKey": "0x1A", "scanCode": "0x7B", "repeatable": false, "tone": "modifier" },
        { "label": "", "scanCode": "0x39", "width": 4.5 },
        { "label": "あ", "boxedLabel": true, "virtualKey": "0x16", "scanCode": "0x79", "repeatable": false, "tone": "modifier" },
        { "label": "Alt", "scanCode": "0x38", "extended": true, "modifier": "Alt" },
        { "label": "Ctrl", "scanCode": "0x1D", "extended": true, "modifier": "Ctrl" },
        { "label": "", "scanCode": "0x00", "spacer": true, "width": 3.0 }
      ]
