<Window
    x:Class="TouchKeyboard.Views.KeyboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:Microsoft.UI.Xaml.Controls.Primitives">

    <!--
        キーはここに直書きしない（絶対制約 4）。
        layouts/jis-full.json を LayoutLoader が読み、コードから流し込む。
    -->
    <Grid x:Name="Shell">
        <Grid.Resources>
            <!--
                盤の中の字は同梱のフォントで揃える。ヘッダーやメニューもこれに従う。
                ここに置くのは、この木の下だけに効かせるため。設定画面や通知領域の
                メニューは Windows の既定の書体のままにする。

                太字（BodyStrong など）にあたる書体は同梱していない。
                求められた場合は Regular から合成される。
            -->
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/GenInterfaceJP-Regular.ttf#Gen Interface JP</FontFamily>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <!--
                フローティング専用のタイトルバー。ドッキング中は畳む。
                画面端に接しているときは移動も閉じる操作も要らず、
                その分をキーに使ったほうがよい。
            -->
            <RowDefinition x:Name="TitleRow" Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            テンキーとクリップボード履歴のパネル。本体を置き換えず、重ねて出す。
            Flyout や Popup は使わない。別の HWND を作る経路があり、
            フォーカスを奪わない前提（絶対制約 2）を保証しきれない。

            タイトルバーの行には広げず、本体の行に収める。

            素材（SystemBackdropElement）は合成側で描かれ、Canvas.ZIndex では
            タイトルバーの下に回らない。重なりで解けないので、重ならないようにする。

            本体（Body）より手前に出す。宣言はこちらが先なので、指定しないと奥へ回る。
        -->
        <Grid x:Name="PanelHost" Grid.Row="1"
              Canvas.ZIndex="1" Visibility="Collapsed">

            <!-- パネルが覆っていない部分。触ったら閉じる -->
            <Border x:Name="PanelScrim" />

            <!--
                端まで詰めて置く。境目は内側の辺だけ引く。
                内側の余白は Root と同じにして、キーの大きさと行の位置を本体に揃える。

                素材はパネル全体を覆う必要がある。Border の Padding の内側に置くと、
                ふちだけ素材が乗らず下地の色が残る。
                そのため余白は中身側の Margin で取り、素材と境界線は全面に敷く。
            -->
            <Grid x:Name="NumpadPanel"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Stretch"
                  Visibility="Collapsed">

                <SystemBackdropElement x:Name="NumpadBackdrop" />
                <Border x:Name="NumpadEdgeLine" BorderThickness="1,0,0,0" />
                <Grid x:Name="NumpadRoot" Margin="8,20,8,8" />
            </Grid>

            <Grid x:Name="ClipboardPanel"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Stretch"
                  Visibility="Collapsed">

                <SystemBackdropElement x:Name="ClipboardBackdrop" />
                <Border x:Name="ClipboardEdgeLine" BorderThickness="0,0,1,0" />

                <Grid x:Name="ClipboardRoot" Margin="8,20,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               x:Name="ClipboardTitle"
                               Text="クリップボードの履歴"
                               Margin="4,0,0,8"
                               FontSize="13" />

                    <!--
                        ListView は使わない。ListViewItem が独自にポインタを扱うため、
                        札を払う操作と取り合いになる。項目はコードで組んでおり、
                        選択も並べ替えも要らないので、縦に積むだけで足りる。

                        横方向は止める。払う操作をこちらが横スクロールとして
                        受け取ってしまうと、札が動かない。
                    -->
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ClipboardList" Orientation="Vertical" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!--
            端まで届く帯として置く。キーの余白の内側に置くと、
            ウィンドウの一部ではなく本体に載った操作列に見える。
        -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="48"
              Canvas.ZIndex="2" Visibility="Collapsed">
            <Border x:Name="TitleBarFill" />
            <Border x:Name="TitleBarLine" BorderThickness="0,0,0,1" />

            <!--
                左右の余白の列は、システムのボタンが占める幅を受ける。
                幅は LeftInset / RightInset から入れる。決め打ちにしない。
            -->
            <Grid x:Name="TitleBarContent">

                <!--
                    塗りと枠を落としてフラットにする。
                    既定の見た目のまま並べると、タイトルバーの上でボタンだけが浮く。

                    Background を直に指定しても、ホバーや押下の状態で
                    テンプレート側の指定に戻される。色そのものを差し替える。
                -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#18808080" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#30808080" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />

                    <!--
                        入のときは既定のまま（アクセント色）にする。
                        そこが状態を伝える唯一の手がかりなので、消してはいけない。
                        切のときだけ塗りと枠を落とす。
                    -->
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#18808080" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#30808080" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
                </Grid.Resources>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftPaddingColumn" Width="0" />
                    <ColumnDefinition x:Name="LeftButtonColumn" Width="Auto" />
                    <ColumnDefinition x:Name="DragColumn" Width="*" />
                    <ColumnDefinition x:Name="RightButtonColumn" Width="Auto" />
                    <ColumnDefinition x:Name="RightPaddingColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <!--
                    字面は Segoe Fluent Icons の実物を描き出して確認した値。
                    E77F=Paste / E8EF=Calculator / E713=Settings。
                    何のボタンかは字形だけでは伝わらないので ToolTip を添える。

                    余白は四方とも 4 で揃える。ボタンの間も同じ 4。
                    40 の箱をタイトルバーの 48 に収めると上下に 4 ずつ残るので、
                    左右と間もそれに合わせる。
                -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Margin="4">
                    <p:ToggleButton x:Name="TitleClipboard"
                                    Content="&#xE77F;"
                                    ToolTipService.ToolTip="クリップボード履歴"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="18" Width="40" Height="40" Padding="0" MinWidth="0" />
                    <p:ToggleButton x:Name="TitleNumpad"
                                    Content="&#xE8EF;"
                                    ToolTipService.ToolTip="テンキー"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="18" Width="40" Height="40" Padding="0" MinWidth="0" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Margin="4">
                    <p:ToggleButton x:Name="TitleSettings"
                                    Content="&#xE713;"
                                    ToolTipService.ToolTip="設定"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="18" Width="40" Height="40" Padding="0" MinWidth="0" />

                    <!--
                        ドッキングの切り替えは押すたびに意味が変わる。文言で示す。
                        語のボタンだけは正方形にできない。高さだけ揃える。
                    -->
                    <Button x:Name="TitleDock" Content="フローティング"
                            Height="40" Padding="14,0" MinWidth="0" FontSize="13" />

                    <Button x:Name="HideButton"
                            Content="&#xE711;"
                            ToolTipService.ToolTip="閉じる"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="18" Width="40" Height="40" Padding="0" MinWidth="0" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="Body" Grid.Row="1">

            <!--
                ドッキング中は上だけ広い。そこがドラッグの帯で、指で捉えられる幅が要る。
                浮かせている間はハンドルがタイトルバーへ移るので四辺とも同じにする。
                実際の値は ApplyBodyInsets が入れる。
            -->
            <Grid x:Name="Root" Margin="8,20,8,8">
                <Grid.RowDefinitions>
                    <!-- 状態とエラーの行。普段は畳んでおく -->
                    <RowDefinition x:Name="HeaderRow" Height="0" />
                    <!-- キー段。残り全体を占め、行は均等に分ける -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="HeaderBar" Grid.Row="0" Margin="4,0"
                      Visibility="Collapsed">
                    <TextBlock x:Name="LogText"
                               FontSize="11"
                               Margin="2,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid x:Name="KeyRoot" Grid.Row="1" />
            </Grid>

            <!--
                高さ変更のハンドル。上の余白の帯そのものに置く。
                ドラッグの操作はすべてこの帯の中で完結させる。
                キーに重ねると、打鍵と引き出しの区別が付かなくなる。
            -->
            <Border x:Name="ResizeGrip" Height="20"
                    VerticalAlignment="Top" Background="Transparent">
                <Border x:Name="GripBar"
                        Width="44" Height="4" CornerRadius="2"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False" />
            </Border>

            <!--
                パネルを引き出す帯。上端の左右に置き、中央はグリップに残す。

                画面の左右端は使わない。そこは Windows のエッジジェスチャの領域で、
                アプリより先に処理されて届かない。ウィンドウ単位で無効にする API も無い。
                キーボードの上端は画面の中ほどにあるため、この問題が起きない。
            -->
            <Border x:Name="LeftEdge" Height="20" Width="180"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="Transparent" />

            <Border x:Name="RightEdge" Height="20" Width="180"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="Transparent" />

            <!-- グリップを短く押したときのメニュー -->
            <Grid x:Name="MenuHost" Visibility="Collapsed">
                <Border x:Name="MenuScrim" Background="Transparent" />

                <Grid x:Name="MenuCard"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Margin="0,18,0,0"
                      CornerRadius="8">

                    <SystemBackdropElement x:Name="MenuBackdrop" />
                    <Border x:Name="MenuEdgeLine" BorderThickness="1" CornerRadius="8" />

                    <!--
                        字面はタイトルバーと同じものを使う。
                        こちらは場所に余裕があるので語も残す。押す前に何が起きるか分かる。
                    -->
                    <StackPanel Orientation="Horizontal" Spacing="4" Padding="6">

                        <!--
                            入のときは既定のまま（アクセント色）にする。
                            そこが状態を伝える唯一の手がかりなので、消してはいけない。
                        -->
                        <StackPanel.Resources>
                            <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#20808080" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#38808080" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
                        </StackPanel.Resources>

                        <p:ToggleButton x:Name="MenuClipboard">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="&#xE77F;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="クリップボード履歴" VerticalAlignment="Center" />
                            </StackPanel>
                        </p:ToggleButton>

                        <p:ToggleButton x:Name="MenuNumpad">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="&#xE8EF;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="テンキー" VerticalAlignment="Center" />
                            </StackPanel>
                        </p:ToggleButton>

                        <p:ToggleButton x:Name="MenuSettings">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="設定" VerticalAlignment="Center" />
                            </StackPanel>
                        </p:ToggleButton>

                        <!-- 押すたびに意味が変わる。文言で示す -->
                        <Button x:Name="MenuDock">
                            <TextBlock x:Name="MenuDockText" Text="フローティング"
                                       VerticalAlignment="Center" />
                        </Button>

                        <Button x:Name="MenuClose">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- 非表示の字面は自前の閉じるボタンと同じものを使う -->
                                <TextBlock Text="&#xE711;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="閉じる" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

        </Grid>

        <!--
            大きさを変えるための当たり判定。浮かせている間だけ出す。
            本体より後に置いて手前に重ねる。先に置くと押下が本体に取られる。

            システムのリサイズ枠（WS_THICKFRAME）は使わない。
            付けると上端に線が出る。
        -->
        <Border x:Name="ResizeLeft" Grid.Row="0" Grid.RowSpan="2"
                Width="6" HorizontalAlignment="Left"
                Canvas.ZIndex="3" Background="Transparent" Visibility="Collapsed" />

        <Border x:Name="ResizeRight" Grid.Row="0" Grid.RowSpan="2"
                Width="6" HorizontalAlignment="Right"
                Canvas.ZIndex="3" Background="Transparent" Visibility="Collapsed" />

        <Border x:Name="ResizeBottom" Grid.Row="1"
                Height="6" VerticalAlignment="Bottom"
                Canvas.ZIndex="3" Background="Transparent" Visibility="Collapsed" />

        <Border x:Name="ResizeTop" Grid.Row="0"
                Height="6" VerticalAlignment="Top"
                Canvas.ZIndex="3" Background="Transparent" Visibility="Collapsed" />

        <!--
            四隅。縦横を同時に変える。
            辺より後に置いて手前に重ねる。重ならないと、角を押しても片方しか動かない。
            指で狙える大きさが要るので、辺より広く取る。
        -->
        <!--
            上の 2 つはタイトルバーのボタンと同じ場所にある。
            広く取るとボタンの角を奪うので、下の 2 つより小さくする。
            単一方向の変更は辺の帯が受けるため、ここは斜めのぶんだけでよい。
        -->
        <Border x:Name="ResizeTopLeft" Grid.Row="0"
                Width="10" Height="10"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Canvas.ZIndex="3" Background="Transparent" Visibility="Collapsed" />

        <Border x:Name="ResizeTopRight" Grid.Row="0"
                Width="10" Height="10"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Canvas.ZIndex="3" Background="Transparent" Visibility="Collapsed" />

        <Border x:Name="ResizeBottomLeft" Grid.Row="1"
                Width="20" Height="20"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Canvas.ZIndex="3" Background="Transparent" Visibility="Collapsed" />

        <Border x:Name="ResizeBottomRight" Grid.Row="1"
                Width="20" Height="20"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Canvas.ZIndex="3" Background="Transparent" Visibility="Collapsed" />
    </Grid>
</Window>
